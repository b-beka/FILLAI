# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Model Configuration
# Доступные модели: gpt-3.5-turbo, gpt-4-turbo-preview, gpt-4o, gpt-4o-mini
OPENAI_MODEL=gpt-3.5-turbo
TEMPERATURE=0.7

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/fillai_db
# Для продакшена используйте полный URL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Configuration (для верификации email и восстановления пароля)
# Выберите провайдера: resend (рекомендуется) или sendgrid
EMAIL_PROVIDER=resend

# Resend (рекомендуется - простой и современный API)
# Получите API ключ на https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# SendGrid (альтернатива)
# Получите API ключ на https://sendgrid.com
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Email отправителя (должен быть верифицирован в вашем email провайдере)
EMAIL_FROM=noreply@fillai.com

# Frontend URL (для ссылок в письмах)
FRONTEND_URL=http://localhost:3000

