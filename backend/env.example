# ================================================================
#  >>> СЮДА ВСТАВЬТЕ КЛЮЧ AI <<<  (https://openrouter.ai/keys)
#  Подходит ключ OpenRouter (с OPENAI_BASE_URL ниже) или OpenAI (тогда уберите OPENAI_BASE_URL)
#  Пример:  OPENAI_API_KEY=sk-or-v1-abc123...   — без кавычек и пробелов
#  После правки перезапустите бэкенд.
# ================================================================
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Model Configuration
# Доступные модели: gpt-3.5-turbo, gpt-4-turbo-preview, gpt-4o, gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
TEMPERATURE=0.7

# Database Configuration
DATABASE_URL=sqlite:///./fillai.db
# Для продакшена используйте полный URL:
# Supabase: Session pooler, драйвер указывается явно
# DATABASE_URL=postgresql+psycopg2://user.project-ref:password@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Configuration (для верификации email и восстановления пароля)
# Выберите провайдера: resend (рекомендуется) или sendgrid
EMAIL_PROVIDER=resend

# Resend (рекомендуется - простой и современный API)
# Получите API ключ на https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# SendGrid (альтернатива)
# Получите API ключ на https://sendgrid.com
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Email отправителя (должен быть верифицирован в вашем email провайдере)
EMAIL_FROM=noreply@fillai.com

# Frontend URL (для ссылок в письмах)
FRONTEND_URL=http://localhost:3000

